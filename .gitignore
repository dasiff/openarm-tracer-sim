# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
dist/
build/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Data and logs (data/ is ignored, except the safety-filter fixture file, which is tracked; a `!` line cannot re-include a file under an ignored directory, so the rule ignores the contents)
data/*
!data/safety_filter/
data/safety_filter/*
!data/safety_filter/kong_single_pair_fixtures.json
*.hdf5
*.h5
*.log

# OS
.DS_Store
Thumbs.db

# Simulation outputs
*.mp4
*.avi
# Virtual envs
.venv/

# Licensed geo_kin artifacts (never commit)
*.whl
*license*.toml
snapshots/
MUJOCO_LOG.TXT

# Private assets (face images etc.), never committed
assets/private/

# CodeGraph index (generated, rebuild with codegraph init)
.codegraph/

# Local files that are not part of the project (kept on disk, never tracked)
/scratch/
/measstart
/compare_nosag.py
/extract_height_data.py
.claude/settings.local.json
