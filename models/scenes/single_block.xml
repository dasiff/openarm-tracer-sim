<?xml version='1.0' encoding='utf-8'?>
<mujoco model="single_block">
  <!-- Define the robot model -->
  <include file="../../deps/OpenArm-Combined/combined_robot.xml"/>
  
  <!-- Add scene objects -->
  <worldbody>
    <!-- Simple block on the floor -->
    <body name="block" pos="0.5 0 0.55">
      <inertial mass="0.5" pos="0 0 0" diaginertia="0.001 0.001 0.001" />
      <geom name="block_collision" type="box" size="0.05 0.05 0.05" friction="1.0" />
      <geom name="block_visual" type="box" size="0.05 0.05 0.05" rgba="1 0 0 1" />
    </body>
  </worldbody>
</mujoco>